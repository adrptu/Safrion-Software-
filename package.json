{
  "name": "safrion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0 && node tools/dev/fronteiras.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/domain/tsconfig.json && tsc -p packages/db/tsconfig.json",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc -b packages/domain/tsconfig.build.json packages/db/tsconfig.build.json",
    "check": "pnpm run doctor && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "doctor": "node tools/dev/doctor.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
