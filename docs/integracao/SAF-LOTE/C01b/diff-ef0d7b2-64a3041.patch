+  r['LG ocTabela Nova Lagoa 2027/28'] = mede(tab('NLG28', CU, TAL['Lagoa Grande']));
+  r['LG ocChecar lg01 (editar, Pivô 1)'] = mede(() => X.ocChecar(ctx, S, CU, CU, 'LG2627', 'lg01', Tlg));
