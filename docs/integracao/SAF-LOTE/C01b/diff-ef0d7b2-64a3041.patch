+    const t = []; for (let i = 0; i < 3; i++) { const a0 = process.hrtime.bigint(); pm.push(X.ocPlantioMin(ctx, S2, x, 'H2728', exc, X.ocDia('2027-09-01'), 500, null)); t.push(Number(process.hrtime.bigint() - a0) / 1e6); }
+    t.sort((p, q) => p - q);
