+// Verificador · base × HEAD nas sementes (Santa Rita, Boa Vista, Lagoa Grande): ocTabela de cada safra + novas, ocChecar sem mudança e com área +10 % de cada cultivo.
+const fs=require('node:fs'), vm=require('node:vm');
