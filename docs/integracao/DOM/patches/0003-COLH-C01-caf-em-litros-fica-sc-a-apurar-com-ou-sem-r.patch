+// ---- C01n · linha e painel da carga (Cargas e recebimento): litros a apurar → sacas medidas, pela mesma regra ----
+{ const A = base(5); const g = A.r.g; const TX = (x) => { try { return prCargaCafeTxt(x); } catch (e) { return String(e.message || e); } };
