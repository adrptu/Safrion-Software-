+     X.R.apurar === false && row.s.colh === '50 sc' && row.s.prtv === '10,00 sc/ha · safra parcial' && /meta 38 sc\/ha −73,7 %$/.test(row.s.ref) && row.v.colh === 3000, [X.R.apurar, row.s, row.v.colh]); }
