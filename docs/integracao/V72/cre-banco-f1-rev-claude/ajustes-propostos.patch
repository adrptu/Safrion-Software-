diff -ru a/tools/prototipo/v37/gen37/credito_ficha_build.py b/tools/prototipo/v37/gen37/credito_ficha_build.py
--- a/tools/prototipo/v37/gen37/credito_ficha_build.py	2026-10-16 21:37:48.862671070 +0000
