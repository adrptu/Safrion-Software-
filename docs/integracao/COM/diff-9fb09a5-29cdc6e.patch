+        cp[p['nome']] = dict(id=p['id'], nome=p['nome'], papeis=papeis, cond=p.get('pag') or '', lim=p.get('lim') or None, limv=p.get('limv') or '',
+                             entrega=p.get('entrega') or '', prod=list(p.get('prod') or []), veic=[v for v in veic if v in CP.VEICULOS])
+    veic = []
