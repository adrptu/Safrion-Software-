Ramo restante do COM-IDEM-01 (Codex 6092005836): a conferência da devolução
gravada só rodava quando o lote vinha no pedido. Agora, sempre que a repetição
traz devolução, exige a devolução do recibo com origem gravada; o lote pedido só
é comparado quando informado. Entrega sem devolução repete como antes.

Teste: comercial_unit RV-IDEMf (sem a devolução do recibo e sem lote: conflito)
e RV-IDEMg (entrega sem devolução repete). Antes (3fcf47c) FALHOU 111/112;
depois OK 112/112. Harness do Codex com a contraprova dele: antes 8/9, depois 9/9.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Div8EjesSwVnpSUvYjZ7kh
---
 tools/prototipo/v37/gen37/comercial.js      | 6 ++++--
 tools/prototipo/v37/gen37/comercial_unit.js | 8 +++++++-
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/tools/prototipo/v37/gen37/comercial.js b/tools/prototipo/v37/gen37/comercial.js
index 5450d2f..4c8830f 100644
--- a/tools/prototipo/v37/gen37/comercial.js
+++ b/tools/prototipo/v37/gen37/comercial.js
@@ -362,9 +362,11 @@ function comDevolverEf(c, rm, lote, kg, motivo, quem, d, chave, imp) { const P =
 function comEntregar(c, k) { const P = comP(c); const rm = P.expedicoes[k.rm]; if (!rm) throw new Error('Carga ' + k.rm + ' não encontrada.');
   const imp = JSON.stringify([k.rm, k.d || '', k.dev ? [prNum(k.dev.kg), k.dev.motivo || ''] : null]);
   /* COM-IDEM-01: a origem da devolução confere pela origem efetiva gravada (vale também para recibos antigos, cuja impressão não tem o lote):
-     outro lote pedido com a mesma chave é conflito; sem lote (seleção automática) vale a origem gravada; sem a devolução gravada não há como provar: conflito */
+     outro lote pedido com a mesma chave é conflito; sem lote (seleção automática) vale a origem gravada; com devolução pedida, sem a devolução do recibo
+     (ou sem origem gravada) não há como provar a igualdade: conflito, com ou sem lote (COM-REV-20261010-03). Entrega sem devolução continua como estava */
   if (rm.entrega) { if (k.chave && rm.entrega.chave === k.chave) { if (rm.entrega.imp !== imp) throw prConflito(k.chave, rm.id);
-      if (k.dev && k.dev.lote) { const dv0 = (rm.devs || []).find(x => x.chave === k.chave + '-DEV'); if (!dv0 || dv0.de !== k.dev.lote) throw prConflito(k.chave, rm.id + (dv0 ? ' com a devolução do ' + dv0.de : '')); }
+      if (k.dev) { const dv0 = (rm.devs || []).find(x => x.chave === k.chave + '-DEV');
+        if (!dv0 || !dv0.de || (k.dev.lote && dv0.de !== k.dev.lote)) throw prConflito(k.chave, rm.id + (dv0 && dv0.de ? ' com a devolução do ' + dv0.de : '')); }
       return { msg: 'Entrega da ' + rm.id + ' já confirmada: nada foi gravado de novo.', rm, repetido: true }; }
     throw new Error('Entrega da ' + rm.id + ' já confirmada em ' + prBr(rm.entrega.d) + ': nada foi gravado de novo.'); }
   if (rm.st !== 'Em trânsito') throw new Error(rm.id + ' está ' + rm.st.toLowerCase() + ': só carga em trânsito tem entrega a confirmar.');
diff --git a/tools/prototipo/v37/gen37/comercial_unit.js b/tools/prototipo/v37/gen37/comercial_unit.js
index 87ed28a..7f42b52 100644
--- a/tools/prototipo/v37/gen37/comercial_unit.js
+++ b/tools/prototipo/v37/gen37/comercial_unit.js
@@ -303,7 +303,13 @@ caso('RV-IDEM', () => { const c = NOVO60(); EMTRANSITO(c); const rm0 = c.produca
   /* sem a devolução gravada com a chave do recibo não há como provar a origem: conflito explícito, nunca sucesso */
   c2.producao.expedicoes['RM-0002'].devs[0].chave = 'OUTRA'; const S3 = JSON.stringify(c2);
   const r6 = MUD(c2, x => comEntregar(x, Object.assign({}, E2, { dev: Object.assign({}, E2.dev, { lote: de }) })));
-  ok('RV-IDEMe sem a devolução do recibo, pedir o lote é conflito (não dá para provar a igualdade); nada gravado', /conflito/.test(r6.erro || '') && JSON.stringify(c2) === S3, r6); });
+  ok('RV-IDEMe sem a devolução do recibo, pedir o lote é conflito (não dá para provar a igualdade); nada gravado', /conflito/.test(r6.erro || '') && JSON.stringify(c2) === S3, r6);
+  /* COM-REV-20261010-03: sem a devolução do recibo, repetir SEM lote (seleção automática) também é conflito; entrega sem devolução repete como antes */
+  const r7 = MUD(c2, x => comEntregar(x, E2));
+  ok('RV-IDEMf sem a devolução do recibo, repetir sem lote é conflito (origem não comprovada); nada gravado', /conflito/.test(r7.erro || '') && !r7.repetido && JSON.stringify(c2) === S3, r7);
+  const c3 = NOVO60(); EMTRANSITO(c3); const E3 = { rm: 'RM-0002', d: '2026-09-26', ator: 'Rui', chave: 'I-S' }; MUD(c3, x => comEntregar(x, E3)); const S4 = JSON.stringify(c3);
+  const r8 = MUD(c3, x => comEntregar(x, E3));
+  ok('RV-IDEMg entrega sem devolução repete com a mesma chave, sem conferir devolução; nada gravado', r8.repetido && JSON.stringify(c3) === S4, r8); });
 caso('RV-A3', () => { const c = NOVO60(); EMTRANSITO(c); const PP = () => c.producao;
   MUD(c, x => comEntregar(x, { rm: 'RM-0002', d: '2026-09-26', dev: { kg: 400, motivo: 'Maturação avançada' }, ator: 'Rui', chave: 'T-E' })); const lid = PP().expedicoes['RM-0002'].devs[0].lote;
   const er = ['Dora', 'Rui', 'Caio', 'Paula', ''].map(a => MUD(c, x => prLiberarLote(x, lid, a)).erro || '');
