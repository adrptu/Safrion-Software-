# Na CI, os valores vêm de variáveis do environment hml (TF_VAR_*). Localmente, só para validate.
# Nunca coloque senha ou segredo aqui: o Terraform não recebe valor de segredo.
projeto_id     = "safrion-hml-exemplo"
projeto_numero = "123456789012"
operador       = "user:operador@example.com"
oidc_client_id = "000000000000-exemplo.apps.googleusercontent.com"

# Saídas do bootstrap (rede privada, ADR 0006).
rede_self_link    = "https://www.googleapis.com/compute/v1/projects/safrion-hml-exemplo/global/networks/safrion-hml"
subrede_self_link = "https://www.googleapis.com/compute/v1/projects/safrion-hml-exemplo/regions/southamerica-east1/subnetworks/safrion-hml-run"
faixa_psa_nome    = "safrion-hml-psa"

# 1ª aplicação: false. Depois das versões dos segredos: true com os números abaixo.
criar_cloud_run = false

# versoes_segredos = {
#   admin       = 1
#   migrator    = 1
#   app_runtime = 1
#   oidc        = 1
# }

# Opcionais (padrões em variables.tf).
